[Unit]
Description=RA-TDMAs+ AlphaBot2 Node (Nó 1)
After=meshnode.service
Requires=meshnode.service

[Service]
Type=simple
WorkingDirectory=/home/pi/Documentos/RoutingMeshNet/RoutingMesh
# Espera após o meshnode arrancar para a sincronização TDMA assentar (os slots
# convergem) ANTES de ligar o vídeo, que compete com a convergência.
# Ver GUIA.txt secção 0.1. Reduzido para 30 s durante os testes.
ExecStartPre=/bin/sleep 30
ExecStart=/usr/bin/python3 alphabot_node.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
User=root

[Install]
WantedBy=multi-user.target
